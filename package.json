{
  "name": "wepuzzle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "tsc --noEmit && vinext build && node scripts/copy-hosting.mjs",
    "build:vercel": "tsc --noEmit && cross-env NITRO_PRESET=vercel vite build --config vite.vercel.config.ts",
